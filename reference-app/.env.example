# MOPA Reference Application — minimal local environment
#
# For the full monorepo/Connectathon environment, copy
# connectathon.env.example to connectathon.env and start Turbo with
# `pnpm exec turbo run dev --env-mode=loose`. Keep partner credentials out of Git.

# FHIR server base URL
FHIR_BASE_URL=http://localhost:8080/fhir

# Jane Smith fixture patient ID (set after running fixtures/load-fixtures.sh)
JANE_SMITH_PATIENT_ID=jane-smith

# Set to "true" to bypass SMART auth (Phases 1-3)
SMART_AUTH_BYPASS=true

# Forward structured service events to the Hub Activity tab.
LOG_HUB_URL=http://localhost:4000/api/log
