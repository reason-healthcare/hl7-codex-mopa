# MOPA Connectathon environment template
#
# Copy this file to connectathon.env. Keep connectathon.env private and do not
# commit credentials. Empty CRD_PARTNER_* values select the bundled local CRD.

# Shared local services
FHIR_BASE_URL=http://localhost:8080/fhir
LOG_HUB_URL=http://localhost:4000/api/log
SMART_AUTH_BYPASS=true
NEXT_PUBLIC_EHR_BASE_URL=http://localhost:4001
NEXT_PUBLIC_CRD_SERVICE_URL=http://localhost:4003
DTR_CLIENT_URL=http://localhost:4004
NEXT_PUBLIC_DTR_CLIENT_URL=http://localhost:4004
EHR_BASE_URL=http://localhost:4001
EHR_FHIR_BASE_URL=http://localhost:4001/api/fhir
PAS_SERVICE_URL=http://localhost:4005
PAYER_BACKEND_URL=http://localhost:4006

# Docker Compose substitution aliases. Native Node runs can leave these at
# their local defaults; set EHR_PUBLIC_BASE_URL to a partner-reachable public
# URL when the EHR is behind an HTTPS ingress.
EHR_PUBLIC_BASE_URL=http://localhost:4001
CRD_SERVICE_URL=http://localhost:4003
DTR_PUBLIC_BASE_URL=http://localhost:4004

# Optional OAuth-protected partner CRD/DTR.
# Leave CRD_PARTNER_BASE_URL empty for the bundled local CRD. When it is set,
# also set the token URL, client ID, and client secret from the partner's
# private onboarding channel. Do not use NEXT_PUBLIC_ names for secrets.
CRD_PARTNER_BASE_URL=
CRD_PARTNER_TOKEN_URL=
CRD_PARTNER_CLIENT_ID=
CRD_PARTNER_CLIENT_SECRET=
CRD_PARTNER_SCOPE=crd dtr pas
CRD_PARTNER_PREFETCH=true

# Optional separate DTR base. Leave unset when DTR uses CRD_PARTNER_BASE_URL.
# DTR_PARTNER_BASE_URL=

# PAS_SERVICE_URL above remains local by default. It may point to a partner
# only when that partner accepts this app's compact POST /api/fhir/$submit
# contract; use an adapter for another operation or FHIR Bundle shape.
