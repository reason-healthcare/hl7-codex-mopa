       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://hl7.org/fhir/us/codex-mopa/PlanDefinition/RegimenDdACT> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/RegimenDdACT" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example Regimen Definition: ddAC→T (Dose-Dense AC then Paclitaxel)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Canonical definition of dose-dense doxorubicin (60 mg/m²) plus\ncyclophosphamide (600 mg/m²) q14d × 4 cycles (AC phase), followed by paclitaxel\n(175 mg/m²) q14d × 4 cycles (T phase) for breast cancer. Demonstrates\nsequential phase ordering using action.relatedAction with relationship = after-end." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "http://hl7.org/fhir/us/codex-mopa/StructureDefinition/anticancer-regimen-plandefinition" ;
         fhir:link <http://hl7.org/fhir/us/codex-mopa/StructureDefinition/anticancer-regimen-plandefinition>
       ]
     ], [
       fhir:index -1 ;
