       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example Patient: Jane Smith" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Fictional 57-year-old female patient used consistently across all MOPA\nIG examples. DO NOT use real patient data." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
